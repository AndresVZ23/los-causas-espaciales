{
  "$defs": {
    "AnnualObservation": {
      "properties": {
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "year",
        "value"
      ],
      "title": "AnnualObservation",
      "type": "object"
    },
    "AssumptionItem": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": "USER_ASSUMPTION"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "unit"
      ],
      "title": "AssumptionItem",
      "type": "object"
    },
    "BreakEven": {
      "description": "Valor de un factor en el que el VAN es cero, con los demás en el caso base.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "assumed_value": {
          "title": "Assumed Value",
          "type": "number"
        },
        "break_even_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "None si el VAN no cruza cero dentro del rango buscado.",
          "title": "Break Even Value"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "unit",
        "assumed_value",
        "break_even_value",
        "note"
      ],
      "title": "BreakEven",
      "type": "object"
    },
    "Criterion": {
      "description": "Un criterio con su escala de referencia declarada: `worst` puntúa 0 y `best` puntúa 100, con recorte fuera del rango.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "worst": {
          "title": "Worst",
          "type": "number"
        },
        "best": {
          "title": "Best",
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "description": "Procedencia del valor medido o estimado del criterio."
        },
        "basis": {
          "description": "De dónde sale el valor y por qué esa escala de referencia.",
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "unit",
        "direction",
        "weight",
        "worst",
        "best",
        "provenance",
        "basis"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "CriterionScore": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "0–100 en la escala de referencia; None si falta el dato.",
          "title": "Score"
        },
        "contribution": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Aporte al puntaje total, en puntos, con los pesos renormalizados por cobertura.",
          "title": "Contribution"
        }
      },
      "required": [
        "key",
        "value",
        "score",
        "contribution"
      ],
      "title": "CriterionScore",
      "type": "object"
    },
    "DataGap": {
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Provenance",
          "default": "DATA_UNAVAILABLE"
        },
        "impact": {
          "title": "Impact",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "impact",
        "next_action"
      ],
      "title": "DataGap",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "mayor_es_mejor",
        "menor_es_mejor"
      ],
      "title": "Direction",
      "type": "string"
    },
    "FinanceScenario": {
      "properties": {
        "key": {
          "enum": [
            "base",
            "adverso",
            "favorable"
          ],
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "npv": {
          "title": "Npv",
          "type": "number"
        },
        "changes": {
          "description": "Factores que se mueven respecto del caso base, en lenguaje claro.",
          "items": {
            "type": "string"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "npv",
        "changes"
      ],
      "title": "FinanceScenario",
      "type": "object"
    },
    "NasaQuestionAnswer": {
      "properties": {
        "key": {
          "enum": [
            "what",
            "where",
            "how_much",
            "significant",
            "so_what"
          ],
          "title": "Key",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "question_es": {
          "title": "Question Es",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QuestionStatus"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "stage_steps": {
          "items": {
            "type": "integer"
          },
          "title": "Stage Steps",
          "type": "array"
        }
      },
      "required": [
        "key",
        "question",
        "question_es",
        "status",
        "answer",
        "evidence",
        "provenance",
        "stage_steps"
      ],
      "title": "NasaQuestionAnswer",
      "type": "object"
    },
    "PipelineStage": {
      "properties": {
        "step": {
          "title": "Step",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PipelineStatus"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/StageEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tiempo medido en el servidor; None si la etapa no ejecuta cálculo propio.",
          "title": "Duration Ms"
        },
        "answers": {
          "description": "Preguntas del reto NASA que esta etapa sustenta.",
          "items": {
            "enum": [
              "what",
              "where",
              "how_much",
              "significant",
              "so_what"
            ],
            "type": "string"
          },
          "title": "Answers",
          "type": "array"
        }
      },
      "required": [
        "step",
        "key",
        "name",
        "status",
        "summary",
        "provenance"
      ],
      "title": "PipelineStage",
      "type": "object"
    },
    "PipelineStatus": {
      "enum": [
        "COMPLETADO",
        "PARCIAL",
        "LISTO",
        "NO_DISPONIBLE",
        "ERROR"
      ],
      "title": "PipelineStatus",
      "type": "string"
    },
    "Point": {
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Point",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "REAL_DATA",
        "CACHED_DATA",
        "MODEL_ESTIMATE",
        "USER_ASSUMPTION",
        "ILLUSTRATIVE_DEMO",
        "DATA_UNAVAILABLE"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "QuestionStatus": {
      "enum": [
        "RESPONDIDA",
        "PARCIAL",
        "EVIDENCIA_INSUFICIENTE"
      ],
      "title": "QuestionStatus",
      "type": "string"
    },
    "Scorecard": {
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "title": "Criteria",
          "type": "array"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/SubjectScore"
          },
          "title": "Subjects",
          "type": "array"
        },
        "leader": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Leader"
        },
        "margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Puntos entre el primero y el segundo; None con un solo sujeto con puntaje.",
          "title": "Margin"
        },
        "tie": {
          "description": "Empate práctico: margen < 5 puntos o líder primero en menos del 75 % de las combinaciones de pesos.",
          "title": "Tie",
          "type": "boolean"
        },
        "stability_draws": {
          "title": "Stability Draws",
          "type": "integer"
        },
        "weight_sensitivity": {
          "items": {
            "$ref": "#/$defs/WeightSensitivity"
          },
          "title": "Weight Sensitivity",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "method",
        "criteria",
        "subjects",
        "leader",
        "margin",
        "tie",
        "stability_draws",
        "weight_sensitivity",
        "notes"
      ],
      "title": "Scorecard",
      "type": "object"
    },
    "Sector": {
      "enum": [
        "climate",
        "solar",
        "road",
        "real_estate"
      ],
      "title": "Sector",
      "type": "string"
    },
    "SensitivityBar": {
      "description": "Una barra del tornado: el VAN al llevar un solo factor a su extremo bajo y alto, con el resto en el caso base.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "base_value": {
          "title": "Base Value",
          "type": "number"
        },
        "low_value": {
          "title": "Low Value",
          "type": "number"
        },
        "high_value": {
          "title": "High Value",
          "type": "number"
        },
        "npv_at_low": {
          "title": "Npv At Low",
          "type": "number"
        },
        "npv_at_high": {
          "title": "Npv At High",
          "type": "number"
        },
        "swing": {
          "description": "|VAN alto − VAN bajo|; el tornado se ordena por este valor.",
          "title": "Swing",
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "basis": {
          "description": "De dónde sale el rango: dato observado o supuesto del usuario.",
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "unit",
        "base_value",
        "low_value",
        "high_value",
        "npv_at_low",
        "npv_at_high",
        "swing",
        "provenance",
        "basis"
      ],
      "title": "SensitivityBar",
      "type": "object"
    },
    "StageEvidence": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "StageEvidence",
      "type": "object"
    },
    "StudySubject": {
      "description": "Unidad que se analiza y se compara: un sitio, un tramo de corredor o un terreno.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SubjectKind"
        },
        "geometry": {
          "additionalProperties": true,
          "description": "Geometría GeoJSON RFC 7946 (WGS84, longitud-latitud).",
          "title": "Geometry",
          "type": "object"
        },
        "representative_point": {
          "$ref": "#/$defs/Point",
          "description": "Punto donde se consultan NASA POWER y NASADEM para este sujeto."
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "geometry",
        "representative_point"
      ],
      "title": "StudySubject",
      "type": "object"
    },
    "SubjectKind": {
      "enum": [
        "point",
        "segment",
        "polygon"
      ],
      "title": "SubjectKind",
      "type": "string"
    },
    "SubjectScore": {
      "properties": {
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "0–100; None si ningún criterio tiene dato.",
          "title": "Score"
        },
        "coverage": {
          "description": "Fracción del peso con dato disponible (0–1).",
          "title": "Coverage",
          "type": "number"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rank"
        },
        "first_place_share": {
          "description": "Fracción de combinaciones de pesos aleatorias en que el sujeto queda primero.",
          "title": "First Place Share",
          "type": "number"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriterionScore"
          },
          "title": "Criteria",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "score",
        "coverage",
        "rank",
        "first_place_share",
        "criteria"
      ],
      "title": "SubjectScore",
      "type": "object"
    },
    "SubjectSensitivity": {
      "properties": {
        "subject": {
          "description": "Etiqueta del sujeto de estudio.",
          "title": "Subject",
          "type": "string"
        },
        "metric": {
          "default": "VAN",
          "title": "Metric",
          "type": "string"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "base_npv": {
          "title": "Base Npv",
          "type": "number"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/FinanceScenario"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "tornado": {
          "items": {
            "$ref": "#/$defs/SensitivityBar"
          },
          "title": "Tornado",
          "type": "array"
        },
        "break_evens": {
          "items": {
            "$ref": "#/$defs/BreakEven"
          },
          "title": "Break Evens",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "base_npv",
        "scenarios",
        "tornado",
        "break_evens"
      ],
      "title": "SubjectSensitivity",
      "type": "object"
    },
    "TerrainGranule": {
      "properties": {
        "short_name": {
          "enum": [
            "NASADEM_HGT",
            "NASADEM_SC"
          ],
          "title": "Short Name",
          "type": "string"
        },
        "version": {
          "default": "001",
          "title": "Version",
          "type": "string"
        },
        "granule_id": {
          "title": "Granule Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "tile_id": {
          "title": "Tile Id",
          "type": "string"
        },
        "bounding_box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounding Box",
          "type": "array"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "data_url": {
          "title": "Data Url",
          "type": "string"
        },
        "preview_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preview Url"
        },
        "doi_url": {
          "title": "Doi Url",
          "type": "string"
        },
        "catalogue_url": {
          "title": "Catalogue Url",
          "type": "string"
        },
        "access": {
          "const": "EARTHDATA_LOGIN_REQUIRED",
          "default": "EARTHDATA_LOGIN_REQUIRED",
          "title": "Access",
          "type": "string"
        }
      },
      "required": [
        "short_name",
        "granule_id",
        "title",
        "tile_id",
        "bounding_box",
        "updated_at",
        "data_url",
        "preview_url",
        "doi_url",
        "catalogue_url"
      ],
      "title": "TerrainGranule",
      "type": "object"
    },
    "TerrainMetrics": {
      "properties": {
        "elevation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation M"
        },
        "slope_degrees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slope Degrees"
        },
        "aspect_degrees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aspect Degrees"
        },
        "aspect_cardinal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aspect Cardinal"
        },
        "vertical_datum": {
          "default": "EGM96 geoid",
          "title": "Vertical Datum",
          "type": "string"
        }
      },
      "title": "TerrainMetrics",
      "type": "object"
    },
    "TerrainResponse": {
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "dataset": {
          "default": "NASADEM V001",
          "title": "Dataset",
          "type": "string"
        },
        "crs": {
          "default": "EPSG:4326; longitude/latitude",
          "title": "Crs",
          "type": "string"
        },
        "spatial_resolution": {
          "default": "1 arc-second (~30 m at the equator)",
          "title": "Spatial Resolution",
          "type": "string"
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/TerrainSiteResult"
          },
          "title": "Sites",
          "type": "array"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "generated_at",
        "sites",
        "note"
      ],
      "title": "TerrainResponse",
      "type": "object"
    },
    "TerrainSiteResult": {
      "properties": {
        "location": {
          "$ref": "#/$defs/Point"
        },
        "status": {
          "enum": [
            "READY",
            "PENDING",
            "METADATA_ONLY",
            "PARTIAL"
          ],
          "title": "Status",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/TerrainMetrics"
        },
        "granules": {
          "items": {
            "$ref": "#/$defs/TerrainGranule"
          },
          "title": "Granules",
          "type": "array"
        },
